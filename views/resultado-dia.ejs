  <div class="lista-ocorrencias">
    <% resultado.ocorrencias.forEach(function (o) { %>
      <%- include('partials/ocorrencia-item', { o: o }) %>
    <% }); %>
  </div>
<% } %>

<%- include('partials/calendario', { ano: ano, mes: mes, semanas: semanas, dataDestaque: resultado.data }) %>

