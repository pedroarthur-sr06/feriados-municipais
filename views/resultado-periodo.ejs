<%
  const MESES = ["janeiro","fevereiro","março","abril","maio","junho",
                 "julho","agosto","setembro","outubro","novembro","dezembro"];
  const porExtenso = (iso) => {
    const [a, m, d] = iso.split("-");
    return Number(d) + " de " + MESES[Number(m) - 1] + " de " + a;
  };
  const qtd = diasComOcorrencia.length;
%>
<div class="bloco-veredito">
  <p class="linha-contexto"><%= municipio.nome %>/<%= municipio.uf %>, de <%= porExtenso(dataInicioIso) %> a <%= porExtenso(dataFimIso) %></p>
  <h2 class="veredito camada-<%= qtd > 0 ? 'estadual' : 'util' %>">
    <%= qtd === 0 ? "Nenhum dia não útil" : (qtd === 1 ? "1 dia não útil" : qtd + " dias não úteis") %>
  </h2>
  <p class="veredito-nota">
    Em <%= dias.length %> dias do período<%= qtd > 0 ? ", classificados abaixo com a fonte de cada um" : "" %>.
  </p>
</div>

<%- include('partials/aviso-nao-verificado', { statusMunicipal: statusMunicipal }) %>

<%# Exportação e provas num painel só, continuando a laje do veredito: são
    a mesma resposta, não três blocos soltos empilhados. %>
<div class="resposta-painel">
  <div class="exportar-links">
    <a href="/exportar/csv?codigoIbge=<%= municipio.codigoIbge %>&dataInicio=<%= dataInicioIso %>&dataFim=<%= dataFimIso %>">Exportar CSV</a>
    <a href="/exportar/pdf?codigoIbge=<%= municipio.codigoIbge %>&dataInicio=<%= dataInicioIso %>&dataFim=<%= dataFimIso %>">Exportar PDF</a>
  </div>

  <% if (qtd > 0) { %>
    <div class="lista-ocorrencias">
      <% diasComOcorrencia.forEach(function (resultado) { %>
        <% resultado.ocorrencias.forEach(function (o) { %>
          <%- include('partials/ocorrencia-item', { o: o }) %>
        <% }); %>
      <% }); %>
    </div>
  <% } %>
</div>

<div class="calendarios-periodo">
  <% calendarios.forEach(function (c) { %>
    <%- include('partials/calendario', { ano: c.ano, mes: c.mes, semanas: c.semanas }) %>
  <% }); %>
</div>

<%- include('partials/legenda') %>
