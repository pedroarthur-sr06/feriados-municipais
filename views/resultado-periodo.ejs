<div class="resultado-topo">
  <h2><%= municipio.nome %>/<%= municipio.uf %></h2>
  <span class="resultado-data"><%= dataInicioTexto %> → <%= dataFimTexto %></span>
</div>

<div class="exportar-links">
  <a href="/exportar/csv?codigoIbge=<%= municipio.codigoIbge %>&dataInicio=<%= dataInicioIso %>&dataFim=<%= dataFimIso %>">
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v12M7 12l5 5 5-5M5 20h14"></path>
    </svg>
    Exportar CSV
  </a>
  <a href="/exportar/pdf?codigoIbge=<%= municipio.codigoIbge %>&dataInicio=<%= dataInicioIso %>&dataFim=<%= dataFimIso %>">
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v12M7 12l5 5 5-5M5 20h14"></path>
    </svg>
    Exportar PDF
  </a>
</div>

<%- include('partials/aviso-nao-verificado', { statusMunicipal: statusMunicipal }) %>

<%- include('partials/legenda') %>

<div class="calendarios-periodo">
  <% calendarios.forEach(function (c) { %>
    <%- include('partials/calendario', { ano: c.ano, mes: c.mes, semanas: c.semanas }) %>
  <% }); %>
</div>

<p class="resumo-periodo">
  <strong><%= diasComOcorrencia.length %></strong> dia(s) não útil(eis) classificado(s) em
  <strong><%= dias.length %></strong> dia(s) do período.
</p>

<% if (diasComOcorrencia.length === 0) { %>
  <p class="sem-ocorrencias">Nenhum feriado nacional, estadual ou municipal confirmado neste período.</p>
<% } else { %>
  <div class="lista-ocorrencias">
    <% diasComOcorrencia.forEach(function (resultado) { %>
      <% resultado.ocorrencias.forEach(function (o) { %>
        <%- include('partials/ocorrencia-item', { o: o }) %>
      <% }); %>
    <% }); %>
  </div>
<% } %>
