<%
  const doFeriado = feriado ? {
    nome: feriado.nome,
    tipoChave: feriado.tipo,
    abrangencia: feriado.abrangencia,
    uf: feriado.uf,
    codigoIbge: feriado.codigoIbge || "",
    municipioNome: feriado.municipioNome || "",
    modoData: feriado.regraCalculo ? "regra" : "fixa",
    mes: feriado.mes || "",
    dia: feriado.dia || "",
    regraCalculo: feriado.regraCalculo || "",
    anoInicio: feriado.anoInicio || "",
    anoFim: feriado.anoFim || "",
    autor: feriado.autor,
    dataVerificacao: feriado.dataVerificacao,
    observacao: feriado.observacao || "",
    fonteDescricao: feriado.fonteDescricao,
    fonteUrl: feriado.fonteUrl || "",
    fonteTipo: feriado.fonteTipo,
    fonteDataPublicacao: feriado.fonteDataPublicacao || "",
  } : {};

  const v = Object.assign(
    {
      nome: "", tipoChave: "municipal", abrangencia: "municipio", uf: "", codigoIbge: "", municipioNome: "",
      modoData: "fixa", mes: "", dia: "", regraCalculo: "", anoInicio: "", anoFim: "",
      autor: "", dataVerificacao: new Date().toISOString().slice(0, 10), observacao: "",
      fonteDescricao: "", fonteUrl: "", fonteTipo: "lei", fonteDataPublicacao: "",
    },
    doFeriado,
    typeof prefill !== "undefined" ? prefill : {},
  );

  const acaoForm = feriado ? `/admin/feriados/${feriado.id}/editar` : `/admin/feriados/novo${candidatoId ? '?candidatoId=' + candidatoId : ''}`;
%>
<%- include('partials/head', { titulo: typeof titulo !== "undefined" ? titulo : "Feriado — Administração" }) %>
<body>
  <header class="topo">
    <h1><%= feriado ? "Editar feriado" : "Novo feriado curado" %></h1>
    <p class="subtitulo">Toda fonte precisa ser primária (lei, decreto, Diário Oficial) — nunca um blog agregador.</p>
    <%- include('partials/nav') %>
  </header>

  <main>
    <p><a class="botao-link" href="/admin">← voltar</a></p>

    <% if (typeof erro !== "undefined" && erro) { %>
      <div class="erro" role="alert" style="margin-bottom: 1rem;"><%= erro %></div>
    <% } %>

    <form method="post" action="<%= acaoForm %>" class="formulario-admin" x-data="{ abrangencia: '<%= v.abrangencia %>', modoData: '<%= v.modoData %>' }">
      <div class="campo">
        <label for="nome">Nome do feriado</label>
        <input type="text" id="nome" name="nome" value="<%= v.nome %>" required />
      </div>

      <div class="linha-campos">
        <div class="campo">
          <label for="tipoChave">Tipo</label>
          <select id="tipoChave" name="tipoChave" required>
            <option value="estadual" <%= v.tipoChave === "estadual" ? "selected" : "" %>>Estadual</option>
            <option value="municipal" <%= v.tipoChave === "municipal" ? "selected" : "" %>>Municipal</option>
            <option value="ponto_facultativo" <%= v.tipoChave === "ponto_facultativo" ? "selected" : "" %>>Ponto facultativo</option>
          </select>
        </div>
        <div class="campo">
          <label for="uf">UF</label>
          <select id="uf" name="uf" required>
            <option value="">—</option>
            <% ufs.forEach(function (uf) { %>
              <option value="<%= uf %>" <%= v.uf === uf ? "selected" : "" %>><%= uf %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <fieldset>
        <legend>Abrangência</legend>
        <div class="opcoes-modo">
          <label><input type="radio" name="abrangencia" value="uf" x-model="abrangencia" <%= v.abrangencia === "uf" ? "checked" : "" %> /> Estado inteiro (UF)</label>
          <label><input type="radio" name="abrangencia" value="municipio" x-model="abrangencia" <%= v.abrangencia === "municipio" ? "checked" : "" %> /> Um município específico</label>
        </div>
        <div class="campo" x-show="abrangencia === 'municipio'" x-cloak>
          <label for="municipio-busca">Município</label>
          <input type="text" id="municipio-busca" autocomplete="off" placeholder="Digite o nome do município..."
                 value="<%= v.municipioNome %>"
                 hx-get="/municipios/busca" hx-trigger="keyup changed delay:300ms, focus"
                 hx-target="#lista-municipios" hx-swap="innerHTML" />
          <input type="hidden" id="codigoIbge" name="codigoIbge" value="<%= v.codigoIbge %>" />
          <div id="lista-municipios" class="lista-sugestoes"></div>
          <p class="ajuda-campo">A UF do município selecionado precisa bater com a UF escolhida acima.</p>
        </div>
      </fieldset>

      <fieldset>
        <legend>Data</legend>
        <div class="opcoes-modo">
          <label><input type="radio" name="modoData" value="fixa" x-model="modoData" <%= v.modoData === "fixa" ? "checked" : "" %> /> Data fixa</label>
          <label><input type="radio" name="modoData" value="regra" x-model="modoData" <%= v.modoData === "regra" ? "checked" : "" %> /> Regra baseada na Páscoa</label>
        </div>
        <div class="linha-campos" x-show="modoData === 'fixa'" x-cloak>
          <div class="campo">
            <label for="dia">Dia</label>
            <input type="number" id="dia" name="dia" min="1" max="31" value="<%= v.dia %>" />
          </div>
          <div class="campo">
            <label for="mes">Mês</label>
            <input type="number" id="mes" name="mes" min="1" max="12" value="<%= v.mes %>" />
          </div>
        </div>
        <div class="campo" x-show="modoData === 'regra'" x-cloak>
          <label for="regraCalculo">Regra (ex.: "pascoa", "pascoa+60", "pascoa-47")</label>
          <input type="text" id="regraCalculo" name="regraCalculo" value="<%= v.regraCalculo %>" placeholder="pascoa+60" />
        </div>
      </fieldset>

      <fieldset>
        <legend>Vigência (opcional)</legend>
        <div class="linha-campos">
          <div class="campo">
            <label for="anoInicio">Válido a partir do ano</label>
            <input type="number" id="anoInicio" name="anoInicio" value="<%= v.anoInicio %>" placeholder="deixe vazio se sempre valeu" />
          </div>
          <div class="campo">
            <label for="anoFim">Válido até o ano</label>
            <input type="number" id="anoFim" name="anoFim" value="<%= v.anoFim %>" placeholder="deixe vazio se ainda vale" />
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Fonte (obrigatória — sempre primária)</legend>
        <div class="campo">
          <label for="fonteDescricao">Descrição da fonte</label>
          <textarea id="fonteDescricao" name="fonteDescricao" required placeholder="Ex.: Lei Municipal nº 123, de 01/01/2000, art. 1º"><%= v.fonteDescricao %></textarea>
        </div>
        <div class="linha-campos">
          <div class="campo">
            <label for="fonteTipo">Tipo de fonte</label>
            <select id="fonteTipo" name="fonteTipo" required>
              <% tiposFonte.forEach(function (t) { %>
                <option value="<%= t %>" <%= v.fonteTipo === t ? "selected" : "" %>><%= t %></option>
              <% }); %>
            </select>
          </div>
          <div class="campo">
            <label for="fonteDataPublicacao">Data da norma (opcional)</label>
            <input type="date" id="fonteDataPublicacao" name="fonteDataPublicacao" value="<%= v.fonteDataPublicacao %>" />
          </div>
        </div>
        <div class="campo">
          <label for="fonteUrl">URL da fonte (opcional, mas recomendado)</label>
          <input type="text" id="fonteUrl" name="fonteUrl" value="<%= v.fonteUrl %>" placeholder="https://..." />
        </div>
      </fieldset>

      <fieldset>
        <legend>Auditoria</legend>
        <div class="linha-campos">
          <div class="campo">
            <label for="autor">Autor (quem está confirmando)</label>
            <input type="text" id="autor" name="autor" value="<%= v.autor %>" required placeholder="seu nome ou e-mail" />
          </div>
          <div class="campo">
            <label for="dataVerificacao">Data da verificação</label>
            <input type="date" id="dataVerificacao" name="dataVerificacao" value="<%= v.dataVerificacao %>" required />
          </div>
        </div>
        <div class="campo">
          <label for="observacao">Observação (opcional)</label>
          <textarea id="observacao" name="observacao"><%= v.observacao %></textarea>
        </div>
      </fieldset>

      <button type="submit"><%= feriado ? "Salvar alterações" : "Cadastrar feriado" %></button>
    </form>
  </main>

  <%- include('partials/foot') %>

  <script>
    function selecionarMunicipio(codigoIbge, nome, uf) {
      document.getElementById("codigoIbge").value = codigoIbge;
      document.getElementById("municipio-busca").value = nome + " / " + uf;
      document.getElementById("lista-municipios").innerHTML = "";
      const campoUf = document.getElementById("uf");
      if (campoUf && !campoUf.value) campoUf.value = uf;
    }
  </script>
</body>
</html>
