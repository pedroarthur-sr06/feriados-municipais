<article class="ocorrencia camada-<%= o.camada %>">
  <strong class="ocorrencia-nome"><%= o.nome %></strong>
  <p class="ocorrencia-camada"><%= DESCRICAO_CAMADA[o.camada] %> — <%= porExtenso(o.data) %></p>
  <p class="ocorrencia-fonte">
    <%= o.baseLegal %><% if (o.fonteUrl) { %>
      <a href="<%= o.fonteUrl %>" target="_blank" rel="noopener noreferrer">ver fonte</a><% } %>
  </p>
  <% if (o.dataVerificacao) { %>
    <p class="ocorrencia-verificacao">
      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="m4 12.5 5 5L20 6.5"></path>
      </svg>
      Conferido em <%= porExtenso(o.dataVerificacao) %>
    </p>
  <% } %>
</article>
