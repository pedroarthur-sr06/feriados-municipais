<% const termoBusca = (typeof termo !== "undefined" && termo) ? termo.trim() : ""; %>
<% if (municipios.length === 0) { %>
  <% if (termoBusca.length > 0) { %>
    <p class="sem-resultado">Nenhum município encontrado para “<%= termoBusca %>”.</p>
  <% } %>
<% } else { %>
  <ul class="sugestoes">
    <% municipios.forEach(function (m) { %>
      <li>
        <button type="button"
          onclick="selecionarMunicipio(<%= m.codigoIbge %>, '<%- m.nome.replace(/'/g, "\\'") %>', '<%= m.uf %>')">
          <%= m.nome %> <span class="uf">/ <%= m.uf %></span>
        </button>
      </li>
    <% }); %>
  </ul>
<% } %>
