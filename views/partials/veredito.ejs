<%
  /* Frase, cor e ressalva são decididas em src/web/veredito.ts. Aqui só se
     apresenta. */
  const v = montarVeredito(resultado, municipio.nome);
%>
<div class="bloco-veredito">
  <p class="linha-contexto"><%= municipio.nome %>/<%= municipio.uf %>, <%= resultado.diaSemana %>, <%= porExtenso(resultado.data) %></p>
  <h2 class="veredito camada-<%= v.camada %>"><%= v.frase %></h2>
  <% if (v.nota) { %>
    <p class="veredito-nota"><%= v.nota %></p>
  <% } %>
</div>
