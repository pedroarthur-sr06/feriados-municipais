<%
  /* Classes, title e marcador vêm de src/web/calendario.ts — o mesmo módulo
     que o HTML offline embute. Aqui só se desenha. */
  const grade = apresentarCalendario(semanas, typeof dataDestaque !== "undefined" ? dataDestaque : undefined);
%>
<div class="calendario-wrap">
  <p class="calendario-titulo"><%= nomeMes(mes) %> de <%= ano %></p>
  <table class="calendario">
    <thead>
      <tr>
        <% DIAS_CABECALHO.forEach(function (d) { %><th scope="col" class="<%= d.fimDeSemana ? 'fim-de-semana' : '' %>"><%= d.rotulo %></th><% }); %>
      </tr>
    </thead>
    <tbody>
      <% grade.forEach(function (semana) { %>
        <tr>
          <% semana.forEach(function (c) { %>
            <% if (c.dia === null) { %>
              <td class="<%= c.classes %>"></td>
            <% } else { %>
              <td class="<%= c.classes %>" <% if (c.titulo) { %>title="<%= c.titulo %>"<% } %>>
                <%= c.dia %><% if (c.marcador) { %><span class="marcador-multiplo"><%= c.marcador %></span><% } %>
              </td>
            <% } %>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
