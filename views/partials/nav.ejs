<%
  const atual = typeof paginaAtual !== "undefined" ? paginaAtual : "";
%>
<aside class="rail">
  <a class="rail-marca" href="/">
    <span class="rail-apoio" role="img" aria-label="Apoio"></span>
    <span class="rail-marca-fio" aria-hidden="true"></span>
    <span class="rail-marca-texto">
      <strong>Feriados</strong>
      <span>Municipais</span>
    </span>
  </a>

  <nav class="rail-nav" aria-label="Seções">
    <a href="/" class="rail-item <%= atual === 'consulta' ? 'ativo' : '' %>" <%= atual === 'consulta' ? 'aria-current="page"' : '' %>>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6"></path>
      </svg>
      <span>Consulta</span>
    </a>
    <a href="/lote" class="rail-item <%= atual === 'lote' ? 'ativo' : '' %>" <%= atual === 'lote' ? 'aria-current="page"' : '' %>>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
        <path d="M3 9.5h18M9 9.5V20M15 9.5V20"></path>
      </svg>
      <span>Operação em lote</span>
    </a>
    <a href="/admin" class="rail-item <%= atual === 'administracao' ? 'ativo' : '' %>" <%= atual === 'administracao' ? 'aria-current="page"' : '' %>>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7h10M18 7h2M4 17h2M10 17h10"></path>
        <circle cx="16" cy="7" r="2.2"></circle>
        <circle cx="8" cy="17" r="2.2"></circle>
      </svg>
      <span>Administração</span>
    </a>
  </nav>

  <p class="rail-nota">
    Cada feriado aqui carrega a <strong>norma que o cria</strong>, quem conferiu e quando.
  </p>
</aside>
