<%
  const atual = typeof paginaAtual !== "undefined" ? paginaAtual : "";
%>
<%# Barra no topo, não mais coluna lateral: sobraram dois destinos, e uma
    coluna de 236px gastava 20% de uma tela de 1366px para mostrá-los. A
    largura devolvida é o que deixa a prova e o calendário conviverem lado a
    lado na resposta. %>
<header class="barra">
  <a class="barra-marca" href="/">
    <span class="barra-simbolo" role="img" aria-label="Apoio"></span>
    <span class="barra-marca-texto">Feriados <span>Municipais</span></span>
  </a>

  <nav class="barra-nav" aria-label="Seções">
    <a href="/" class="barra-item <%= atual === 'consulta' ? 'ativo' : '' %>" <%= atual === 'consulta' ? 'aria-current="page"' : '' %>>Consulta</a>
    <a href="/lote" class="barra-item <%= atual === 'lote' ? 'ativo' : '' %>" <%= atual === 'lote' ? 'aria-current="page"' : '' %>>Operação em lote</a>
  </nav>
</header>
