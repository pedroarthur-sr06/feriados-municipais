{
  "name": "feriados-municipais",
  "version": "0.1.0",
  "private": true,
  "description": "Consulta de feriados nacionais, estaduais e municipais para fechamento de ponto.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:municipios": "tsx src/scripts/seed-municipios.ts",
    "seed:tipos-feriado": "tsx src/scripts/seed-tipos-feriado.ts",
    "seed:candidatos": "tsx src/scripts/seed-candidatos.ts",
    "seed:feriados-curados": "tsx src/scripts/seed-feriados-curados.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^11.10.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "pdfmake": "^0.3.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.0",
    "@types/pdfmake": "^0.3.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
